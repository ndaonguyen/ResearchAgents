@page "/"
@rendermode InteractiveServer
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>AgentScope</PageTitle>

<div class="app">
    <header>
        <h1>AgentScope</h1>
        <span class="subtitle">Week 2 — orchestrator: planner → researchers → critic → synthesizer</span>
    </header>

    <section class="chat">
        <div class="input-row">
            <input @bind="_question" @bind:event="oninput" @onkeydown="OnKeyDown"
                   placeholder="Ask anything..." disabled="@_running" />
            <button @onclick="Ask" disabled="@(_running || string.IsNullOrWhiteSpace(_question))">
                @(_running ? "Running…" : "Ask")
            </button>
        </div>

        <div class="graph">
            <div class="stage @StageClass(_plannerStatus)">
                <div class="stage-name">Planner</div>
                <div class="stage-badge">@StageBadge(_plannerStatus)</div>
            </div>
            <div class="stage-arrow">→</div>
            <div class="stage @StageClass(ResearcherStageStatus)">
                <div class="stage-name">Researchers</div>
                <div class="stage-badge">
                    @if (_researchersStarted > 0)
                    {
                        <span>@_researchersFinished / @_researchersStarted</span>
                    }
                    else
                    {
                        <span>@StageBadge(StageStatus.Idle)</span>
                    }
                </div>
            </div>
            <div class="stage-arrow">→</div>
            <div class="stage @StageClass(_criticStatus)">
                <div class="stage-name">Critic</div>
                <div class="stage-badge">@StageBadge(_criticStatus)</div>
            </div>
            <div class="stage-arrow">→</div>
            <div class="stage @StageClass(_synthesizerStatus)">
                <div class="stage-name">Synthesizer</div>
                <div class="stage-badge">@StageBadge(_synthesizerStatus)</div>
            </div>
        </div>

        <div class="answer">
            @if (!string.IsNullOrEmpty(_answer))
            {
                <pre>@_answer</pre>
            }
            else if (_running)
            {
                <div class="placeholder">Thinking…</div>
            }
            else
            {
                <div class="placeholder">The answer will appear here, streaming as the synthesizer works.</div>
            }
        </div>
    </section>

    <section class="events">
        <h2>Event log</h2>
        <div class="event-list">
            @if (_events.Count == 0)
            {
                <div class="placeholder">Events from the agent run will appear here.</div>
            }
            else
            {
                @foreach (var e in _events)
                {
                    <div class="event @e.Kind.Replace(".", "-")">
                        <span class="time">@e.Timestamp.ToString("HH:mm:ss.fff")</span>
                        <span class="kind">@e.Kind</span>
                        <span class="agent">@e.AgentId</span>
                        @if (!string.IsNullOrEmpty(e.Detail))
                        {
                            <span class="detail">@e.Detail</span>
                        }
                    </div>
                }
            }
        </div>
    </section>
</div>

<style>
    .app { max-width: 1100px; margin: 0 auto; padding: 24px; font-family: system-ui, sans-serif; }
    header { display: flex; align-items: baseline; gap: 12px; margin-bottom: 20px; }
    h1 { margin: 0; font-size: 1.6rem; }
    .subtitle { color: #666; font-size: 0.9rem; }
    .chat { margin-bottom: 24px; }
    .input-row { display: flex; gap: 8px; margin-bottom: 12px; }
    .input-row input { flex: 1; padding: 10px 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 1rem; }
    .input-row button { padding: 10px 18px; border: 0; border-radius: 6px; background: #2563eb; color: white; font-weight: 600; cursor: pointer; }
    .input-row button:disabled { background: #94a3b8; cursor: not-allowed; }
    .graph { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; }
    .stage { flex: 1; min-width: 140px; padding: 10px 12px; border-radius: 8px; border: 1px solid #e2e8f0; background: #f8fafc; text-align: center; transition: all 0.2s; }
    .stage-name { font-weight: 600; font-size: 0.9rem; }
    .stage-badge { font-size: 0.75rem; color: #64748b; margin-top: 4px; font-family: 'JetBrains Mono', 'Consolas', monospace; }
    .stage-arrow { color: #cbd5e1; font-size: 1.2rem; }
    .stage.idle { opacity: 0.6; }
    .stage.running { border-color: #60a5fa; background: #eff6ff; box-shadow: 0 0 0 3px rgba(96,165,250,0.15); }
    .stage.running .stage-badge { color: #2563eb; }
    .stage.done { border-color: #34d399; background: #f0fdf4; }
    .stage.done .stage-badge { color: #16a34a; }
    .stage.error { border-color: #f87171; background: #fef2f2; }
    .stage.error .stage-badge { color: #dc2626; }
    .answer { min-height: 80px; padding: 16px; background: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0; }
    .answer pre { margin: 0; white-space: pre-wrap; word-wrap: break-word; font-family: inherit; }
    .placeholder { color: #94a3b8; font-style: italic; }
    .events { background: #0f172a; color: #cbd5e1; border-radius: 8px; padding: 16px; max-height: 400px; overflow-y: auto; }
    .events h2 { color: white; margin: 0 0 12px; font-size: 1rem; }
    .event-list .placeholder { color: #64748b; }
    .event { display: grid; grid-template-columns: 100px 130px 100px 1fr; gap: 8px; padding: 4px 0; font-family: 'JetBrains Mono', 'Consolas', monospace; font-size: 0.8rem; border-bottom: 1px solid #1e293b; }
    .event .time { color: #64748b; }
    .event .kind { font-weight: 600; }
    .event.agent-started .kind { color: #34d399; }
    .event.agent-finished .kind { color: #34d399; }
    .event.agent-token .kind { color: #60a5fa; }
    .event.tool-called .kind { color: #fbbf24; }
    .event.tool-result .kind { color: #fbbf24; }
    .event.agent-error .kind { color: #f87171; }
    .event .agent { color: #a78bfa; }
    .event .detail { color: #cbd5e1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>

@code {
    private string _question = "";
    private string _answer = "";
    private bool _running;
    private readonly List<UiEvent> _events = new();
    private IJSObjectReference? _module;
    private DotNetObjectReference<Home>? _selfRef;

    private StageStatus _plannerStatus = StageStatus.Idle;
    private int _researchersStarted;
    private int _researchersFinished;
    private StageStatus _criticStatus = StageStatus.Idle;
    private StageStatus _synthesizerStatus = StageStatus.Idle;

    private StageStatus ResearcherStageStatus =>
        _researchersStarted == 0 ? StageStatus.Idle
        : _researchersFinished < _researchersStarted ? StageStatus.Running
        : StageStatus.Done;

    private static string StageClass(StageStatus s) => s switch
    {
        StageStatus.Running => "running",
        StageStatus.Done => "done",
        StageStatus.Error => "error",
        _ => "idle"
    };

    private static string StageBadge(StageStatus s) => s switch
    {
        StageStatus.Running => "running…",
        StageStatus.Done => "done",
        StageStatus.Error => "error",
        _ => "idle"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./js/agent-hub.js");
            await _module.InvokeVoidAsync("init", _selfRef);
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_running && !string.IsNullOrWhiteSpace(_question))
            await Ask();
    }

    private async Task Ask()
    {
        if (_module is null) return;

        _running = true;
        _answer = "";
        _events.Clear();

        // Reset the graph for the new run.
        _plannerStatus = StageStatus.Idle;
        _researchersStarted = 0;
        _researchersFinished = 0;
        _criticStatus = StageStatus.Idle;
        _synthesizerStatus = StageStatus.Idle;

        StateHasChanged();

        await _module.InvokeVoidAsync("ask", _question);
    }

    [JSInvokable]
    public Task OnEvent(string kind, System.Text.Json.JsonElement payload)
    {
        var ts = payload.TryGetProperty("timestamp", out var tsEl)
            ? tsEl.GetDateTime() : DateTime.UtcNow;

        // AgentId is serialized as { "value": "..." } because it's a readonly record struct.
        var agentId = ExtractIdValue(payload, "agentId");

        var detail = kind switch
        {
            "agent.token" => payload.TryGetProperty("delta", out var d) ? Truncate(d.GetString(), 60) : "",
            "tool.called" => payload.TryGetProperty("toolName", out var t) ? t.GetString() ?? "" : "",
            "tool.result" => payload.TryGetProperty("durationMs", out var ms) ? $"{ms.GetInt64()}ms" : "",
            "agent.error" => payload.TryGetProperty("message", out var m) ? m.GetString() ?? "" : "",
            _ => ""
        };

        _events.Add(new UiEvent(kind, agentId, ts, detail));

        // Only the synthesizer's tokens form the user-facing answer.
        // Planner/researcher/critic tokens are intermediate; they're visible in the event log.
        if (kind == "agent.token" && agentId == "synthesizer"
            && payload.TryGetProperty("delta", out var deltaEl))
            _answer += deltaEl.GetString();

        UpdateGraph(kind, agentId);

        // The run only ends on a system-level finished/error event — sub-agents finishing
        // is not the same as the run finishing.
        if ((kind == "agent.finished" || kind == "agent.error") && agentId == "system")
            _running = false;

        StateHasChanged();
        return Task.CompletedTask;
    }

    private void UpdateGraph(string kind, string agentId)
    {
        if (kind == "agent.started")
        {
            if (agentId == "planner") _plannerStatus = StageStatus.Running;
            else if (agentId == "critic") _criticStatus = StageStatus.Running;
            else if (agentId == "synthesizer") _synthesizerStatus = StageStatus.Running;
            else if (agentId.StartsWith("researcher-")) _researchersStarted++;
        }
        else if (kind == "agent.finished")
        {
            if (agentId == "planner") _plannerStatus = StageStatus.Done;
            else if (agentId == "critic") _criticStatus = StageStatus.Done;
            else if (agentId == "synthesizer") _synthesizerStatus = StageStatus.Done;
            else if (agentId.StartsWith("researcher-")) _researchersFinished++;
        }
        else if (kind == "agent.error")
        {
            // Mark whichever stage was currently running as errored.
            if (_synthesizerStatus == StageStatus.Running) _synthesizerStatus = StageStatus.Error;
            else if (_criticStatus == StageStatus.Running) _criticStatus = StageStatus.Error;
            else if (_researchersStarted > _researchersFinished) { /* researcher stage errored */ }
            else if (_plannerStatus == StageStatus.Running) _plannerStatus = StageStatus.Error;
        }
    }

    private enum StageStatus { Idle, Running, Done, Error }

    private static string ExtractIdValue(System.Text.Json.JsonElement payload, string propName)
    {
        if (!payload.TryGetProperty(propName, out var prop))
            return "";

        // System.Text.Json serializes a record struct as an object with its properties.
        return prop.ValueKind == System.Text.Json.JsonValueKind.Object
            && prop.TryGetProperty("value", out var v)
                ? v.GetString() ?? ""
                : prop.GetString() ?? "";
    }

    private static string Truncate(string? s, int max) =>
        string.IsNullOrEmpty(s) ? "" : s.Length <= max ? s : s.Substring(0, max) + "…";

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { /* circuit closing */ }
        }
        _selfRef?.Dispose();
    }

    private sealed record UiEvent(string Kind, string AgentId, DateTime Timestamp, string Detail);
}
