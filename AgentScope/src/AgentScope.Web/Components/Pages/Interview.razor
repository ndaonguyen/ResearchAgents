@page "/interview"
@rendermode InteractiveServer
@using AgentScope.Application.Abstractions
@using AgentScope.Application.Interview
@using AgentScope.Domain.Agents
@using AgentScope.Domain.Events
@using AgentScope.Domain.Interview
@using AgentScope.Domain.Runs
@using AgentScope.Web.Services
@inject InterviewSessionUseCase Session
@inject IAgentEventBus Bus
@inject RunPersister Persister
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>ResearchAgent — Interview practice</PageTitle>

<div class="app">
    <header>
        <h1>Interview practice</h1>
        <span class="subtitle">System design + Architecture — grounded in your indexed book corpora</span>
        @if (_session is not null && (_session.TotalTokensIn > 0 || _session.TotalTokensOut > 0))
        {
            <span class="session-cost">
                <span class="session-tokens">@_session.TotalTokensIn.ToString("N0") in / @_session.TotalTokensOut.ToString("N0") out</span>
                @if (_session.TotalCostUsd is { } cost)
                {
                    <span class="session-cost-usd">@cost.ToString("C4", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
                }
            </span>
        }
        @if (_ttsAvailable)
        {
            <button class="mute-toggle" @onclick="ToggleMute" title="@(_muted ? "Unmute" : "Mute")">
                @(_muted ? "🔇 Voice off" : "🔊 Voice on")
            </button>
        }
    </header>

    @if (_session is null)
    {
        <section class="topic-picker">
            <label>Topic:</label>
            <select @bind="_selectedTopicId" disabled="@_busy">
                @foreach (var track in Enum.GetValues<InterviewTrack>())
                {
                    foreach (var group in new[] { TopicGroup.Concept, TopicGroup.Exercise })
                    {
                        var topics = _topics.Where(x => x.Track == track && x.Group == group).ToList();
                        if (topics.Count == 0) continue;
                        var label = $"{InterviewTrackCorpus.DisplayName(track)} — {(group == TopicGroup.Concept ? "Concepts" : "Design exercises")}";
                        <optgroup label="@label">
                            @foreach (var t in topics)
                            {
                                <option value="@t.Id">@t.DisplayName</option>
                            }
                        </optgroup>
                    }
                }
            </select>

            <div class="mode-picker">
                <label class="mode-option">
                    <input type="radio" name="mode" value="discussion"
                           checked="@(_selectedMode == InterviewMode.Discussion)"
                           @onchange="@(() => _selectedMode = InterviewMode.Discussion)"
                           disabled="@_busy" />
                    Discussion (long-form, multi-turn)
                </label>
                <label class="mode-option">
                    <input type="radio" name="mode" value="quickcheck"
                           checked="@(_selectedMode == InterviewMode.QuickCheck)"
                           @onchange="@(() => _selectedMode = InterviewMode.QuickCheck)"
                           disabled="@_busy" />
                    Quick check (batch of multiple-choice questions)
                </label>
            </div>

            @if (_selectedMode == InterviewMode.QuickCheck)
            {
                <div class="batch-size-picker">
                    <span class="batch-size-label">Questions per batch:</span>
                    @foreach (var (size, costLabel, hint) in BatchSizeOptions)
                    {
                        var capturedSize = size;
                        <label class="batch-size-option">
                            <input type="radio" name="batchSize" value="@size"
                                   checked="@(_selectedBatchSize == size)"
                                   @onchange="@(() => _selectedBatchSize = capturedSize)"
                                   disabled="@_busy" />
                            <span class="batch-size-num">@size</span>
                            <span class="batch-size-cost">@costLabel</span>
                            <span class="batch-size-hint">@hint</span>
                        </label>
                    }
                </div>
                <div class="batch-size-note">
                    Estimated cost per batch on gpt-4o-mini (input + output tokens).
                    All options round to fractions of a cent — pick on tempo, not budget.
                </div>
            }

            <button class="primary" @onclick="StartSession" disabled="@_busy">
                @(_busy ? "Starting…" : "Start interview")
            </button>
        </section>
    }
    else if (_session.Mode == InterviewMode.QuickCheck && _session.Questions.Count > 0)
    {
        <section class="mcq-batch">
            <div class="batch-header">
                <div class="batch-title">
                    Quick check — @_session.Topic.DisplayName
                    <span class="mcq-counter">
                        Batch @_batchIndex · @_session.Questions.Count question(s)@(_batchIndex > 1 ? $" · cumulative avg {CumulativeAverage:F1}/5" : "")
                    </span>
                </div>
                @if (_session.BatchSubmitted && _session.Grades is { } gs)
                {
                    <div class="batch-score">
                        Batch score:
                        <span class="score-badge score-@_session.FinalGrade!.Score">@gs.Average().ToString("F1") / 5</span>
                    </div>
                }
            </div>

            @for (var qi = 0; qi < _session.Questions.Count; qi++)
            {
                var i = qi; // capture for closures
                var question = _session.Questions[i];
                var picks = _session.Picks[i];
                var disabled = _session.BatchSubmitted;
                var perQuestionGrade = _session.Grades is { } grades && i < grades.Count ? grades[i] : (int?)null;
                <div class="mcq-card @(perQuestionGrade is null ? "" : (perQuestionGrade == 5 ? "card-correct" : "card-partial"))">
                    <div class="card-header">
                        <span class="card-num">Q@(i + 1)</span>
                        <span class="card-text">@question.Question</span>
                        @if (perQuestionGrade is { } g)
                        {
                            <span class="score-badge score-@g">@g / 5</span>
                        }
                    </div>

                    <div class="mcq-options">
                        @foreach (var opt in question.Options)
                        {
                            var isSingle = question.CorrectCount == 1;
                            var pickedNow = picks.Contains(opt.Id);
                            var resultClass = "";
                            if (_session.BatchSubmitted)
                            {
                                if (opt.IsCorrect) resultClass = "correct";
                                else if (pickedNow) resultClass = "wrong";
                            }
                            <label class="mcq-option @(pickedNow ? "picked" : "") @resultClass">
                                @if (isSingle)
                                {
                                    <input type="radio" name="@($"mcq-{i}")" value="@opt.Id"
                                           checked="@pickedNow"
                                           @onchange="@(() => SelectSingleForQuestion(i, opt.Id))"
                                           disabled="@disabled" />
                                }
                                else
                                {
                                    <input type="checkbox" value="@opt.Id"
                                           checked="@pickedNow"
                                           @onchange="@(() => ToggleMultiForQuestion(i, opt.Id))"
                                           disabled="@disabled" />
                                }
                                <span class="opt-id">@opt.Id.ToUpperInvariant().</span>
                                <span class="opt-text">@opt.Text</span>
                                @if (_session.BatchSubmitted && opt.IsCorrect)
                                {
                                    <span class="opt-marker">✓</span>
                                }
                                @if (_session.BatchSubmitted && !opt.IsCorrect && pickedNow)
                                {
                                    <span class="opt-marker wrong">✗</span>
                                }
                            </label>
                        }
                    </div>

                    @if (_session.BatchSubmitted)
                    {
                        <div class="mcq-explanation">
                            <div class="exp-label">Explanation</div>
                            <p>@question.Explanation</p>
                            @if (question.Citations.Any())
                            {
                                <div class="exp-citations">@string.Join(" · ", question.Citations)</div>
                            }
                        </div>
                    }
                </div>
            }

            @if (!_session.BatchSubmitted)
            {
                <div class="batch-submit">
                    <span class="answered-count">@AnsweredCount / @_session.Questions.Count answered</span>
                    <button class="primary" @onclick="SubmitBatch"
                            disabled="@(_busy || AnsweredCount == 0)">
                        @(_busy ? "Grading…" : "Submit batch")
                    </button>
                </div>
            }
            else
            {
                <div class="batch-actions">
                    <button class="primary" @onclick="NextBatch" disabled="@_busy">
                        @(_busy ? "Loading next batch…" : $"Next {_session.BatchSize} question{(_session.BatchSize == 1 ? "" : "s")} →")
                    </button>
                    <button @onclick="ResetSession" disabled="@_busy">End session</button>
                </div>
            }
        </section>
    }
    else
    {
        <section class="transcript">
            @foreach (var turn in _session.Transcript)
            {
                <div class="turn turn-@turn.Speaker.ToString().ToLowerInvariant()">
                    <div class="speaker">@LabelFor(turn.Speaker)</div>
                    <div class="text">@turn.Text</div>
                </div>
            }

            @if (!string.IsNullOrEmpty(_currentAgentMessage))
            {
                <div class="turn turn-streaming">
                    <div class="speaker">@_currentAgentLabel (typing…)</div>
                    <div class="text">@_currentAgentMessage</div>
                </div>
            }
        </section>

        @if (_session.FinalGrade is null)
        {
            <section class="answer-input">
                <textarea @bind="_userInput" @bind:event="oninput"
                          placeholder="Type your answer here, or click the mic to speak. Be specific — talk through trade-offs, scale, edge cases."
                          disabled="@(_busy || _listening)" rows="8"></textarea>

                @if (!string.IsNullOrEmpty(_interimTranscript))
                {
                    <div class="interim-transcript">…@_interimTranscript</div>
                }

                @if (!string.IsNullOrEmpty(_sttError))
                {
                    <div class="stt-error">Mic error: @_sttError</div>
                }

                <div class="answer-actions">
                    @if (_sttAvailable)
                    {
                        <button class="mic-btn @(_listening ? "listening" : "")" @onclick="ToggleListening" disabled="@_busy">
                            @(_listening ? "🛑 Stop listening" : "🎤 Speak")
                        </button>
                    }
                    <button class="hint-btn" @onclick="RequestHint"
                            disabled="@(_busy || _listening || HintsRemaining == 0)"
                            title="@(HintsRemaining > 0 ? $"{HintsRemaining} hint(s) remaining" : "No hints left")">
                        💡 Hint
                        @if (HintsRemaining < InterviewSessionUseCase.MaxHints)
                        {
                            <span class="hint-count">(@HintsRemaining left)</span>
                        }
                    </button>
                    <button class="giveup-btn" @onclick="ShowAnswer"
                            disabled="@(_busy || _listening)"
                            title="Give up and see the model answer. This question scores 0.">
                        🏳️ Show answer
                    </button>
                    <button class="primary" @onclick="SubmitAnswer"
                            disabled="@(_busy || _listening || string.IsNullOrWhiteSpace(_userInput))">
                        @(_busy ? "Working…" : "Submit answer")
                    </button>
                </div>
            </section>
        }
        else
        {
            <section class="grade-card">
                <div class="score-row">
                    <h2>Grade</h2>
                    <div class="score-badge score-@_session.FinalGrade.Score">
                        @if (_session.FinalGrade.Score == 0) { <span>🏳️ Gave up</span> }
                        else { <span>@_session.FinalGrade.Score / 5</span> }
                    </div>
                </div>

                @if (_session.FinalGrade.Strengths.Any())
                {
                    <h3>Strengths</h3>
                    <ul class="strengths">
                        @foreach (var s in _session.FinalGrade.Strengths)
                        {
                            <li>@s</li>
                        }
                    </ul>
                }

                @if (_session.FinalGrade.Gaps.Any())
                {
                    <h3>Gaps</h3>
                    <ul class="gaps">
                        @foreach (var g in _session.FinalGrade.Gaps)
                        {
                            <li>@g</li>
                        }
                    </ul>
                }

                @if (_session.FinalCoaching is not null)
                {
                    <h3>Coach</h3>
                    <p class="coach-summary">@_session.FinalCoaching.Summary</p>

                    @if (_session.FinalCoaching.SuggestedReading.Any())
                    {
                        <h4>Suggested reading</h4>
                        <ul class="reading">
                            @foreach (var r in _session.FinalCoaching.SuggestedReading)
                            {
                                <li>@r</li>
                            }
                        </ul>
                    }
                }

                <div class="discussion-actions">
                    <button class="primary" @onclick="NextDiscussionQuestion" disabled="@_busy">
                        @(_busy ? "Loading…" : "Next question →")
                    </button>
                    <button @onclick="ResetSession" disabled="@_busy">Start a new interview</button>
                </div>
            </section>
        }
    }
</div>

<style>
    .app { max-width: 900px; margin: 0 auto; padding: 24px; font-family: system-ui, sans-serif; }
    header { display: flex; align-items: baseline; gap: 12px; margin-bottom: 20px; }
    h1 { margin: 0; font-size: 1.6rem; }
    .subtitle { color: #666; font-size: 0.9rem; }

    .topic-picker { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; padding: 24px; background: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0; }
    .topic-picker select { padding: 8px 12px; font-size: 1rem; border: 1px solid #cbd5e1; border-radius: 6px; min-width: 280px; }
    .mode-picker { display: flex; flex-direction: column; gap: 8px; }
    .mode-option { display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 0.95rem; }
    .mode-option input { cursor: pointer; }
    .batch-size-picker { display: flex; flex-direction: column; gap: 6px; padding-left: 24px; }
    .batch-size-label { font-size: 0.9rem; color: #475569; font-weight: 500; }
    .batch-size-option { display: grid; grid-template-columns: 20px 28px 90px 1fr; gap: 8px; align-items: center; cursor: pointer; font-size: 0.9rem; padding: 4px 0; }
    .batch-size-option input { cursor: pointer; margin: 0; }
    .batch-size-num { font-weight: 600; color: #1e293b; }
    .batch-size-cost { color: #047857; font-family: 'JetBrains Mono', 'Consolas', monospace; font-size: 0.85rem; }
    .batch-size-hint { color: #94a3b8; font-size: 0.85rem; }
    .batch-size-note { padding-left: 24px; font-size: 0.8rem; color: #94a3b8; font-style: italic; line-height: 1.4; }
    button.primary { padding: 10px 18px; border: 0; border-radius: 6px; background: #2563eb; color: white; font-weight: 600; cursor: pointer; font-size: 1rem; }
    button.primary:disabled { background: #94a3b8; cursor: not-allowed; }
    button.mute-toggle { padding: 6px 12px; border: 1px solid #cbd5e1; background: white; border-radius: 6px; cursor: pointer; font-size: 0.85rem; }
    button.mute-toggle:hover { background: #f8fafc; }
    .session-cost { margin-left: auto; display: flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono', 'Consolas', monospace; font-size: 0.85rem; }
    .session-tokens { color: #64748b; }
    .session-cost-usd { background: #ecfdf5; color: #047857; padding: 2px 8px; border-radius: 999px; font-weight: 600; }

    .transcript { display: flex; flex-direction: column; gap: 12px; margin: 20px 0; }
    .turn { padding: 12px 16px; border-radius: 8px; border: 1px solid #e2e8f0; }
    .turn .speaker { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: #64748b; margin-bottom: 6px; }
    .turn .text { white-space: pre-wrap; word-wrap: break-word; }
    .turn-interviewer { background: #eff6ff; border-color: #bfdbfe; }
    .turn-interviewer .speaker { color: #1e40af; }
    .turn-probe { background: #fef3c7; border-color: #fde68a; }
    .turn-probe .speaker { color: #92400e; }
    .turn-user { background: #f0fdf4; border-color: #bbf7d0; }
    .turn-user .speaker { color: #15803d; }
    .turn-streaming { background: #f8fafc; border-color: #e2e8f0; opacity: 0.85; }
    .turn-streaming .speaker { color: #475569; }
    .turn-hint { background: #faf5ff; border-color: #d8b4fe; }
    .turn-hint .speaker { color: #7c3aed; }
    .turn-modelanswer { background: #fef3c7; border-color: #fcd34d; }
    .turn-modelanswer .speaker { color: #b45309; }
    .turn-modelanswer .text { font-size: 0.95rem; line-height: 1.6; }

    .answer-input { display: flex; flex-direction: column; gap: 12px; }
    .answer-input textarea { padding: 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-family: inherit; font-size: 0.95rem; resize: vertical; }
    .answer-actions { display: flex; gap: 12px; justify-content: flex-end; align-items: center; }
    .mic-btn { padding: 10px 18px; border: 1px solid #cbd5e1; background: white; border-radius: 6px; cursor: pointer; font-size: 1rem; font-weight: 500; }
    .mic-btn:hover { background: #f8fafc; }
    .mic-btn.listening { background: #fee2e2; border-color: #fca5a5; color: #b91c1c; animation: pulse 1.4s ease-in-out infinite; }
    @@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.6; } }
    .hint-btn { padding: 10px 16px; border: 1px solid #d8b4fe; background: #faf5ff; color: #7c3aed; border-radius: 6px; cursor: pointer; font-size: 1rem; font-weight: 500; }
    .hint-btn:hover:not(:disabled) { background: #f3e8ff; }
    .hint-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .hint-count { margin-left: 4px; font-size: 0.8rem; color: #94a3b8; font-weight: 400; }
    .giveup-btn { padding: 10px 16px; border: 1px solid #fcd34d; background: #fef3c7; color: #b45309; border-radius: 6px; cursor: pointer; font-size: 1rem; font-weight: 500; }
    .giveup-btn:hover:not(:disabled) { background: #fde68a; }
    .giveup-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .score-0 { background: #f1f5f9; color: #475569; }
    .interim-transcript { padding: 8px 12px; background: #f8fafc; border-left: 3px solid #94a3b8; font-style: italic; color: #475569; font-size: 0.9rem; }
    .stt-error { padding: 8px 12px; background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; border-radius: 6px; font-size: 0.85rem; }

    .grade-card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 24px; }
    .grade-card h2, .grade-card h3, .grade-card h4 { margin-top: 0; }
    .grade-card h3 { margin-top: 18px; font-size: 1rem; color: #475569; }
    .grade-card h4 { margin-top: 14px; font-size: 0.9rem; color: #64748b; }
    .grade-card .score-row { display: flex; align-items: center; justify-content: space-between; }
    .score-badge { display: inline-block; padding: 6px 16px; border-radius: 999px; font-weight: 700; font-size: 1.2rem; }
    .score-1, .score-2 { background: #fee2e2; color: #b91c1c; }
    .score-3 { background: #fef3c7; color: #b45309; }
    .score-4 { background: #d1fae5; color: #047857; }
    .score-5 { background: #a7f3d0; color: #065f46; }
    .grade-card .strengths li { color: #15803d; }
    .grade-card .gaps li { color: #b91c1c; }
    .grade-card .coach-summary { font-style: italic; color: #334155; line-height: 1.6; }
    .grade-card .reading li { color: #475569; }
    .grade-card button { margin-top: 18px; padding: 8px 14px; border: 1px solid #cbd5e1; background: white; color: #1e293b; border-radius: 6px; cursor: pointer; }
    .grade-card button:hover { background: #f1f5f9; }
    .grade-card button.primary { padding: 10px 18px; border: 0; background: #2563eb; color: white; font-weight: 600; font-size: 1rem; }
    .grade-card button.primary:hover { background: #1d4ed8; }
    .grade-card button.primary:disabled { background: #94a3b8; }
    .discussion-actions { display: flex; gap: 12px; margin-top: 18px; }

    .mcq { display: flex; flex-direction: column; gap: 16px; }
    .mcq-question { padding: 16px 18px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; }
    .mcq-question .speaker { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: #1e40af; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; }
    .mcq-counter { font-size: 0.75rem; color: #64748b; font-weight: 500; text-transform: none; letter-spacing: 0; }
    .mcq-actions { display: flex; gap: 12px; margin-top: 18px; }
    .mcq-question .text { font-size: 1.05rem; line-height: 1.5; }
    .mcq-options { display: flex; flex-direction: column; gap: 8px; }
    .mcq-option { display: flex; align-items: flex-start; gap: 10px; padding: 12px 14px; border: 1px solid #e2e8f0; border-radius: 8px; cursor: pointer; background: white; }
    .mcq-option:hover:not(.correct):not(.wrong) { background: #f8fafc; border-color: #cbd5e1; }
    .mcq-option.picked { border-color: #2563eb; background: #eff6ff; }
    .mcq-option.correct { border-color: #34d399; background: #f0fdf4; }
    .mcq-option.wrong { border-color: #f87171; background: #fef2f2; }
    .mcq-option input { margin-top: 2px; cursor: pointer; }
    .mcq-option .opt-id { font-weight: 700; color: #475569; margin-right: 4px; }
    .mcq-option .opt-text { flex: 1; }
    .mcq-option .opt-marker { font-weight: 700; color: #16a34a; }
    .mcq-option .opt-marker.wrong { color: #dc2626; }
    .mcq-result { padding: 20px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; }
    .mcq-result .score-row { display: flex; justify-content: space-between; align-items: center; }
    .mcq-result h3 { margin-top: 16px; font-size: 1rem; color: #475569; }
    .mcq-result h4 { margin-top: 12px; font-size: 0.85rem; color: #64748b; }
    .mcq-result p { line-height: 1.6; }
    .mcq-result button { margin-top: 18px; padding: 8px 14px; border: 1px solid #cbd5e1; background: white; color: #1e293b; border-radius: 6px; cursor: pointer; }
    .mcq-result button:hover { background: #f1f5f9; }
    .mcq-result button.primary { padding: 10px 18px; border: 0; background: #2563eb; color: white; font-weight: 600; font-size: 1rem; }
    .mcq-result button.primary:hover { background: #1d4ed8; }
    .mcq-result button.primary:disabled { background: #94a3b8; }
</style>

@code {
    private readonly IReadOnlyList<InterviewTopic> _topics = InterviewTopics.All;
    private string _selectedTopicId = "caching";
    private InterviewMode _selectedMode = InterviewMode.Discussion;
    private int _selectedBatchSize = InterviewSessionUseCase.DefaultQuickCheckBatchSize;

    // Cost labels shown next to each batch-size radio. Estimates are for gpt-4o-mini and
    // assume ~1-2 corpus searches per batch. Adjust if you change the interview model.
    private static readonly (int Size, string Cost, string Hint)[] BatchSizeOptions = new[]
    {
        (2,  "~$0.0012", "fastest"),
        (5,  "~$0.0019", "sweet spot · ~2.5× cheaper per question vs singletons"),
        (10, "~$0.0029", "lowest per-question cost · longer wait per batch")
    };

    private InterviewSession? _session;
    private RunId _runId;
    private string _userInput = "";
    private bool _busy;

    // QuickCheck batch state:
    //  _batchIndex: 1-based batch counter (advances on Next 5).
    //  _cumulativeScores: per-question scores across ALL submitted batches, for cumulative avg.
    //  Per-question picks live on _session.Picks (parallel to _session.Questions) so the UI
    //  binds straight to the session model.
    private int _batchIndex = 0;
    private readonly List<int> _cumulativeScores = new();

    // Discussion: 1-based question counter so each "Next question" persists with a unique
    // QuestionId ({sessionId}-d{N}) for Past Runs grouping.
    private int _discussionQuestionIndex = 0;

    private int AnsweredCount =>
        _session?.Picks.Count(p => p.Count > 0) ?? 0;

    private double CumulativeAverage =>
        _cumulativeScores.Count == 0 ? 0.0 : _cumulativeScores.Average();

    private string? _currentAgentMessage;
    private string _currentAgentLabel = "";

    private CancellationTokenSource? _subscriptionCts;

    private IJSObjectReference? _ttsModule;
    private bool _ttsAvailable;
    private bool _muted;

    private IJSObjectReference? _sttModule;
    private bool _sttAvailable;
    private bool _listening;
    private string _committedTranscript = "";
    private string _interimTranscript = "";
    private string? _sttError;
    private DotNetObjectReference<Interview>? _selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _ttsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/interview-tts.js");
            _ttsAvailable = await _ttsModule.InvokeAsync<bool>("isAvailable");
        }
        catch
        {
            _ttsAvailable = false;
        }

        try
        {
            _sttModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/interview-stt.js");
            _sttAvailable = await _sttModule.InvokeAsync<bool>("isAvailable");
            if (_sttAvailable)
            {
                _selfRef = DotNetObjectReference.Create(this);
            }
        }
        catch
        {
            _sttAvailable = false;
        }

        if (_ttsAvailable || _sttAvailable) StateHasChanged();
    }

    private async Task ToggleListening()
    {
        if (_sttModule is null || _selfRef is null) return;

        if (_listening)
        {
            await _sttModule.InvokeVoidAsync("stopListening");
            // onend callback flips _listening false; we don't need to do it here.
            return;
        }

        _sttError = null;
        _committedTranscript = _userInput;
        _interimTranscript = "";
        var ok = await _sttModule.InvokeAsync<bool>("startListening", _selfRef);
        if (ok)
        {
            _listening = true;
        }
        else
        {
            _sttError = "Could not start speech recognition.";
        }
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnTranscript(string final, string interim)
    {
        if (!string.IsNullOrEmpty(final))
        {
            _committedTranscript = string.IsNullOrEmpty(_committedTranscript)
                ? final
                : _committedTranscript + " " + final;
            _userInput = _committedTranscript;
        }
        _interimTranscript = interim;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnRecognitionError(string error)
    {
        _sttError = error switch
        {
            "not-allowed" => "Microphone permission denied.",
            "no-speech" => "No speech detected.",
            "audio-capture" => "No microphone found.",
            _ => error
        };
        _listening = false;
        _interimTranscript = "";
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnRecognitionEnd()
    {
        _listening = false;
        // Any leftover interim text is dropped — only committed/final transcripts persist.
        _interimTranscript = "";
        return InvokeAsync(StateHasChanged);
    }

    private void ToggleMute()
    {
        _muted = !_muted;
        if (_muted) _ = CancelSpeechAsync();
    }

    private async Task SpeakLatestInterviewerTurnAsync()
    {
        if (_muted || !_ttsAvailable || _ttsModule is null || _session is null) return;
        var last = _session.Transcript.LastOrDefault();
        if (last is null) return;
        // Read aloud anything from the AI side — interviewer question, probe follow-up, or hint.
        if (last.Speaker != Speaker.Interviewer
            && last.Speaker != Speaker.Probe
            && last.Speaker != Speaker.Hint) return;

        try
        {
            await _ttsModule.InvokeVoidAsync("speak", last.Text);
        }
        catch
        {
            // Speech failures are non-fatal; the user can still read the question.
        }
    }

    private async Task CancelSpeechAsync()
    {
        if (_ttsModule is null) return;
        try { await _ttsModule.InvokeVoidAsync("cancel"); } catch { /* circuit may be closing */ }
    }

    private async Task StartSession()
    {
        var topic = InterviewTopics.FindById(_selectedTopicId);
        if (topic is null) return;

        _busy = true;
        _runId = RunId.New();
        _batchIndex = _selectedMode == InterviewMode.QuickCheck ? 1 : 0;
        _discussionQuestionIndex = _selectedMode == InterviewMode.Discussion ? 1 : 0;
        _cumulativeScores.Clear();
        StartEventSubscription(_runId);
        StateHasChanged();

        try
        {
            _session = _selectedMode == InterviewMode.QuickCheck
                ? await Session.StartQuickCheckAsync(topic, _runId, _selectedBatchSize)
                : await Session.StartAsync(topic, _runId);
        }
        finally
        {
            _busy = false;
            _currentAgentMessage = null;
            StateHasChanged();
        }

        // QuickCheck doesn't have an interviewer-spoken turn (questions are on-screen);
        // Discussion mode does.
        if (_session?.Mode == InterviewMode.Discussion)
        {
            await SpeakLatestInterviewerTurnAsync();
        }
    }

    private void SelectSingleForQuestion(int questionIndex, string optionId)
    {
        if (_session is null || questionIndex >= _session.Picks.Count) return;
        _session.Picks[questionIndex].Clear();
        _session.Picks[questionIndex].Add(optionId);
    }

    private void ToggleMultiForQuestion(int questionIndex, string optionId)
    {
        if (_session is null || questionIndex >= _session.Picks.Count) return;
        var set = _session.Picks[questionIndex];
        if (!set.Add(optionId)) set.Remove(optionId);
    }

    private async Task SubmitBatch()
    {
        if (_session is null || _session.Questions.Count == 0) return;
        _busy = true;
        StateHasChanged();

        try
        {
            var picks = _session.Picks
                .Select(s => (IReadOnlyList<string>)s.ToList())
                .ToList();
            await Session.SubmitQuickCheckBatchAsync(_session, picks, _runId);
            if (_session.Grades is { } gs) _cumulativeScores.AddRange(gs);
            await PersistBatchAsync();
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task NextDiscussionQuestion()
    {
        if (_session is null || _session.Mode != InterviewMode.Discussion) return;
        _busy = true;
        _runId = RunId.New();
        _discussionQuestionIndex++;
        StartEventSubscription(_runId);
        StateHasChanged();

        try
        {
            await Session.NextDiscussionQuestionAsync(_session, _runId);
        }
        finally
        {
            _busy = false;
            _currentAgentMessage = null;
            StateHasChanged();
        }

        // Speak the new interviewer question if TTS is enabled.
        await SpeakLatestInterviewerTurnAsync();
    }

    private async Task NextBatch()
    {
        if (_session is null || _session.Mode != InterviewMode.QuickCheck) return;
        _busy = true;
        _runId = RunId.New();
        _batchIndex++;
        StartEventSubscription(_runId);
        StateHasChanged();

        try
        {
            await Session.NextQuickCheckBatchAsync(_session, _runId);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task SubmitAnswer()
    {
        if (_session is null || string.IsNullOrWhiteSpace(_userInput)) return;

        // If the user is still mid-dictation, stop listening before submitting.
        if (_listening && _sttModule is not null)
        {
            try { await _sttModule.InvokeVoidAsync("stopListening"); } catch { }
            _listening = false;
        }

        var answer = _userInput;
        _userInput = "";
        _committedTranscript = "";
        _interimTranscript = "";
        _busy = true;
        StateHasChanged();

        string? probeText = null;
        try
        {
            probeText = await Session.SubmitAnswerAsync(_session, answer, _runId);
            if (probeText is null)
            {
                await Session.FinalizeAsync(_session, _runId);
                await PersistSessionAsync();
            }
        }
        finally
        {
            _busy = false;
            _currentAgentMessage = null;
            StateHasChanged();
        }

        if (probeText is not null)
        {
            await SpeakLatestInterviewerTurnAsync();
        }
    }

    private async Task ResetSession()
    {
        _subscriptionCts?.Cancel();
        _subscriptionCts = null;
        _session = null;
        _userInput = "";
        _committedTranscript = "";
        _interimTranscript = "";
        _sttError = null;
        _currentAgentMessage = null;
        _batchIndex = 0;
        _discussionQuestionIndex = 0;
        _cumulativeScores.Clear();
        if (_listening && _sttModule is not null)
        {
            try { await _sttModule.InvokeVoidAsync("stopListening"); } catch { }
            _listening = false;
        }
        await CancelSpeechAsync();
    }

    private void StartEventSubscription(RunId runId)
    {
        _subscriptionCts?.Cancel();
        _subscriptionCts = new CancellationTokenSource();
        var ct = _subscriptionCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await foreach (var evt in Bus.SubscribeAsync(runId, ct))
                {
                    await ProcessEventAsync(evt);
                }
            }
            catch (OperationCanceledException) { /* expected on dispose */ }
        }, ct);
    }

    private async Task ProcessEventAsync(AgentEvent evt)
    {
        switch (evt)
        {
            case AgentStartedEvent started:
                _currentAgentMessage = "";
                _currentAgentLabel = started.AgentName;
                break;
            case AgentTokenEvent tok:
                _currentAgentMessage = (_currentAgentMessage ?? "") + tok.Delta;
                break;
            case AgentFinishedEvent finished when finished.AgentId != AgentId.System:
                // Sub-agent done — clear the streaming bubble (the finalized text appears via the transcript).
                _currentAgentMessage = null;
                break;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task PersistBatchAsync()
    {
        if (_session is null || _session.Mode != InterviewMode.QuickCheck) return;
        if (!_session.BatchSubmitted || _session.Grades is null) return;

        // Split the batch generation cost evenly across each question's row so the Past Runs
        // viewer shows realistic per-question economics (per-row is the row's share of the
        // batch). Aggregating these rows back up gives the true batch cost.
        var n = _session.Questions.Count;
        var perTokensIn = n > 0 ? _session.LastBatchTokensIn / n : 0;
        var perTokensOut = n > 0 ? _session.LastBatchTokensOut / n : 0;
        decimal? perCost = (_session.LastBatchCostUsd is { } total && n > 0)
            ? total / n
            : null;

        for (var i = 0; i < _session.Questions.Count; i++)
        {
            var q = _session.Questions[i];
            var picks = _session.Picks[i];
            var grade = _session.Grades[i];

            var optionsText = string.Join("\n", q.Options.Select(o =>
                $"  ({o.Id.ToUpperInvariant()}) {o.Text}{(o.IsCorrect ? "  [correct]" : "")}"));
            var questionField = $"[{_session.Topic.DisplayName}] Batch {_batchIndex} Q{i + 1}: {q.Question}\n{optionsText}";
            var pickedText = picks.Count == 0
                ? "(no selection)"
                : string.Join(", ", picks.Select(id => id.ToUpperInvariant()));

            var coaching = q.Explanation +
                (q.Citations.Count > 0
                    ? "\n\nSources:\n  - " + string.Join("\n  - ", q.Citations)
                    : "");

            var row = new EvalRow(
                QuestionId: $"{_session.SessionId}-b{_batchIndex}-q{i + 1}",
                Variant: "interview-quickcheck",
                Question: questionField,
                RunId: _runId.Value,
                Answer: $"Picked: {pickedText}",
                TokensIn: perTokensIn,
                TokensOut: perTokensOut,
                CostUsd: perCost,
                DurationMs: 0,
                Errored: false,
                ErrorMessage: null,
                JudgeScore: grade,
                JudgeReasoning: coaching,
                JudgeTokensIn: 0,
                JudgeTokensOut: 0,
                JudgeCostUsd: null,
                CompletedAt: DateTime.UtcNow);

            await Persister.PersistAsync(row);
        }
    }

    private async Task PersistSessionAsync()
    {
        if (_session?.FinalGrade is null) return;
        if (_session.Mode == InterviewMode.QuickCheck) { await PersistBatchAsync(); return; }

        // Discussion mode: one row per session, full transcript in Answer.
        var questionField = $"[{_session.Topic.DisplayName}] {_session.Transcript.FirstOrDefault()?.Text ?? ""}";
        var answerField = string.Join("\n\n",
            _session.Transcript.Select(t => $"[{t.Speaker}] {t.Text}"));

        var coaching = _session.FinalCoaching is { } c
            ? c.Summary + (c.SuggestedReading.Count > 0 ? "\n\nSuggested reading:\n  - " + string.Join("\n  - ", c.SuggestedReading) : "")
            : null;

        // For multi-question Discussion sessions, suffix with -d{N} so each question gets a
        // unique row; the leading sessionId still correlates them.
        var questionId = _discussionQuestionIndex > 1
            ? $"{_session.SessionId}-d{_discussionQuestionIndex}"
            : _session.SessionId;

        var row = new EvalRow(
            QuestionId: questionId,
            Variant: "interview",
            Question: questionField,
            RunId: _runId.Value,
            Answer: answerField,
            TokensIn: _session.TotalTokensIn,
            TokensOut: _session.TotalTokensOut,
            CostUsd: _session.TotalCostUsd,
            DurationMs: (long)(DateTime.UtcNow - _session.StartedAtUtc).TotalMilliseconds,
            Errored: false,
            ErrorMessage: null,
            JudgeScore: _session.FinalGrade.Score,
            JudgeReasoning: coaching,
            JudgeTokensIn: 0,
            JudgeTokensOut: 0,
            JudgeCostUsd: null,
            CompletedAt: DateTime.UtcNow);

        await Persister.PersistAsync(row);
    }

    private int HintsRemaining =>
        _session is null ? InterviewSessionUseCase.MaxHints
            : Math.Max(0, InterviewSessionUseCase.MaxHints - InterviewSessionUseCase.HintsUsed(_session));

    private async Task RequestHint()
    {
        if (_session is null || _busy || _listening) return;
        if (HintsRemaining == 0) return;

        _busy = true;
        StateHasChanged();

        try
        {
            await Session.RequestHintAsync(_session, _runId);
        }
        finally
        {
            _busy = false;
            _currentAgentMessage = null;
            StateHasChanged();
        }

        // Speak the hint just like the interviewer's questions, if voice is on.
        await SpeakLatestInterviewerTurnAsync();
    }

    private async Task ShowAnswer()
    {
        if (_session is null || _busy || _listening) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "Show the model answer? This question will be scored 0 and the session will end.");
        if (!confirmed) return;

        // Stop any in-progress mic capture before we burn through tokens generating the answer.
        if (_listening && _sttModule is not null)
        {
            try { await _sttModule.InvokeVoidAsync("stopListening"); } catch { }
            _listening = false;
        }

        _busy = true;
        StateHasChanged();

        try
        {
            await Session.ShowAnswerAndFinalizeAsync(_session, _runId);
            await PersistSessionAsync();
        }
        finally
        {
            _busy = false;
            _currentAgentMessage = null;
            StateHasChanged();
        }
    }

    private static string LabelFor(Speaker s) => s switch
    {
        Speaker.Interviewer => "Interviewer",
        Speaker.Probe => "Interviewer (follow-up)",
        Speaker.Hint => "💡 Hint",
        Speaker.ModelAnswer => "🏳️ Model answer",
        Speaker.User => "You",
        _ => s.ToString()
    };

    public async ValueTask DisposeAsync()
    {
        _subscriptionCts?.Cancel();
        _subscriptionCts?.Dispose();
        await CancelSpeechAsync();
        if (_sttModule is not null)
        {
            try { await _sttModule.InvokeVoidAsync("stopListening"); } catch { }
            try { await _sttModule.DisposeAsync(); } catch { }
        }
        if (_ttsModule is not null)
        {
            try { await _ttsModule.DisposeAsync(); } catch { /* circuit closing */ }
        }
        _selfRef?.Dispose();
    }
}
